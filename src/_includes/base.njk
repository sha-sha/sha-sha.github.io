<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="max-image-preview:large">
    <style>
      img:is([sizes="auto" i], [sizes^="auto," i]) {
        contain-intrinsic-size: 3000px 1500px
      }
    </style>
    <link rel="dns-prefetch" href="//www.googletagmanager.com">
    <link rel="canonical" href="https://schlesinger-therapy.co.il/">
    <link rel="shortlink" href="https://schlesinger-therapy.co.il/">
    <title>{{ title }}</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Assistant:wght@200..800&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-LN+7fdVzj6u52u30Kp6M/trliBMCMKTyK833zpbD+pXdCLuTusPj697FH4R/5mcr"
      crossorigin="anonymous">
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-ndDqU0Gzau9qJ1lfW4pNLlhNTkCfHzAVBReH9diLvGRem5+R9g2FzA8ZGN954O5Q"
      crossorigin="anonymous"></script>
    <link rel="stylesheet" href="/css/style.css">
  </head>
  <body>
    {% include "header.njk" %}
    {% include "navbar.njk" %}
    {% block content %}
      {% if language == 'hebrew' %}
        {% set lang_class = "hebrew" %}
      {% else %}
        {% set lang_class = "english" %}
      {% endif %}
      {% if style == "legal" %}
        {% set legal_class = "legal" %}
      {% else %}
        {% set legal_class = "" %}
      {% endif %}
      <div class="container pt-4">
        <div class="row">
          <div class="col-12">
            <div class="main-content {{ lang_class }} {{ legal_class }}">
              {{ content | safe }}
            </div>
          </div>
        </div>
      </div>
    {% endblock %}
    {# {% include "contact_us.njk" %} #}
    {% block footer %}
      {% include "footer.njk" %}
    {% endblock %}
    <script src="/js/main.js"></script>
  </body>
</html>